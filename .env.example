# --- App ---
APP_NAME=School Management API
APP_VERSION=1.0.0
ENV=development
DEBUG=true

# --- Database ---
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://root:@localhost:3306/school_management

# --- JWT / security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# Comma-separated list, or ["*"] for any origin
CORS_ORIGINS=["*"]

# --- Default admin (used to bootstrap the first superuser) ---
DEFAULT_ADMIN_EMAIL=admin@sms.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_NAME=System Administrator
